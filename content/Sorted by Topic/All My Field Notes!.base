views:
  - type: cards
    name: View
    filters:
      and:
        - file.name != "01 Field Notes - Homepage"
        - '!file.tags.contains("bases")'
        - file.tags.contains("fieldnotes")
    groupBy:
      property: file.tags
      direction: ASC
    order:
      - file.name
    sort: []
    cardSize: 550
